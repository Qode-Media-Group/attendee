# Copy this file to .env and fill in the values.
# Generate CREDENTIALS_ENCRYPTION_KEY and DJANGO_SECRET_KEY with:
#   docker compose -f dev.docker-compose.yaml run --rm attendee-app-local python init_env.py
# See docs/environment-variables.md for every setting.

CREDENTIALS_ENCRYPTION_KEY=
DJANGO_SECRET_KEY=

# Postgres and Redis run outside docker compose. The containers reach them on this machine through
# host.docker.internal by default. Only set POSTGRES_HOST and REDIS_URL for other servers, or on
# Linux, where that name isn't defined. localhost won't work: inside a container it's the container.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=attendee_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
REDIS_URL=redis://host.docker.internal:6379/5

# Recording URLs never expire when true. Needs a public-read bucket policy for bot_*-rec_* objects,
# and anyone with a link can download the recording. When false, URLs expire after 30 minutes.
AWS_RECORDING_STORAGE_USE_PERMANENT_LINKS=false

# Bot metadata settings (the defaults are true and 1000)
REQUIRE_STRING_VALUES_IN_METADATA=false
MAX_METADATA_LENGTH=10000

# Google Calendar push notifications need a public https host. Production sets SITE_DOMAIN to it.
# The development settings fix SITE_DOMAIN to localhost:8007, so locally point an https tunnel
# (e.g. ngrok http 8007) at the app and set its host, without https://, here. Without it,
# calendars still sync, but changes are only picked up on the scheduler's daily re-sync.
# EXTERNAL_WEBHOOK_SITE_DOMAIN=
# ALLOWED_HOSTS=localhost,.ngrok-free.app
# Signed-in Google Meet bots sign in through this host too, from the bot's Chrome. Free ngrok
# shows Chrome a warning page instead of the app, which breaks that sign-in, so use a tunnel
# without one. make tunnel starts a Cloudflare tunnel and sets both values here for you.

# Optional ElevenLabs transcription tuning (defaults shown)
# ELEVENLABS_TRANSCRIPTION_UPLOAD_TIMEOUT_SECONDS=120
# ELEVENLABS_TRANSCRIPTION_MP3_BITRATE_KBPS=64

# Group that owns the Docker socket, used to start bot containers. Get it with:
#   stat -c %g /var/run/docker.sock
# DOCKER_GID=986

# # Uncomment to also run the webpage streamer.
# # COMPOSE_PROFILES=webpage-streamer

# DISABLE_SIGNUP=false
# DISABLE_RATE_LIMITING=false
# ATTENDEE_LOG_FORMAT=json
# SERVER_EMAIL="support@entanglecommerce.com"
# ERROR_REPORTS_RECEIVER_EMAIL_ADDRESS="sujan@qidemedia.net"